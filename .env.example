# ─────────────────────────────────────────────────────────────
# MultiAgents RAG FnB — biến môi trường mẫu. Copy sang `.env` và chỉnh.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=local            # local | dev | staging | prod
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO

# ── LLM serving ──────────────────────────────────────────────
# mock  → không cần GPU, trả lời giả (dùng để smoke-test)
# sglang/vllm → trỏ tới server OpenAI-compatible thật
LLM_BACKEND=mock
LLM_BASE_URL=http://localhost:30000/v1
LLM_API_KEY=EMPTY
GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j

# ── RAG ──────────────────────────────────────────────────────
RAG_RETRIEVAL_MODE=hybrid_graph    # keyword | vector | hybrid | hybrid_graph
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.70

# ── Embedding ────────────────────────────────────────────────
# mock (dim 384) chỉ để test; sentence_transformers (bge-m3, dim 1024) cho thật.
EMBEDDING_BACKEND=mock
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu               # cpu | cuda

# ── Reranker ─────────────────────────────────────────────────
RERANKER_BACKEND=null              # null | bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu                # cpu | cuda
RERANKER_THRESHOLD=0.5             # xác suất sau sigmoid (0..1)

# ── Router ───────────────────────────────────────────────────
ROUTER_BACKEND=rule_based          # rule_based | hf_lora | hf_merged
ROUTER_DEVICE=cpu

# ── Intent extractor ─────────────────────────────────────────
INTENT_EXTRACTOR_ENABLED=true
INTENT_EXTRACTOR_BACKEND=rule_based
INTENT_EXTRACTOR_DEVICE=cpu

# ── Cache ────────────────────────────────────────────────────
CACHE_ENABLED=true
EXACT_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true

# ── Concurrency / timeouts ───────────────────────────────────
ROUTER_MAX_CONCURRENCY=8
GENERATOR_MAX_CONCURRENCY=1
REQUEST_TIMEOUT_SECONDS=60
