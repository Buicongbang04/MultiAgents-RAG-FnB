# Copy to .env (git-ignored) and change the placeholder secrets.
# Nested config keys use "__" (env > .env > configs/app.yaml).

NEO4J__PASSWORD=change_me_neo4j

# Postgres (docker compose). Change for anything beyond local dev.
POSTGRES_PASSWORD=fnb
# Host-side URL (app run on host, compose postgres on port 5433).
# Inside compose the backend overrides this to use host "postgres:5432".
DATABASE__URL=postgresql+asyncpg://fnb:fnb@localhost:5433/fnb

ANTHROPIC_API_KEY=

# mock | sglang | vllm | anthropic
LLM__BACKEND=mock
# Optional: route Claude through a private Anthropic-compatible gateway instead of
# api.anthropic.com. Per-machine only; ANTHROPIC_API_KEY is then sent to that host.
# LLM__ANTHROPIC__BASE_URL=https://your-gateway.example.com
# LLM__ANTHROPIC__MODEL=your-gateway-model-id
EMBEDDING__DEVICE=cpu          # cuda if GPU is available
RERANKER__DEVICE=cpu

# Optional host port overrides
# POSTGRES_PORT=5433
# POSTGRES_TEST_PORT=5434
