{"id": "doc_0053", "source_file": "mock_internal_policy.jsonl", "chunk_index": 52, "language": "vi", "text": "Khi khách hỏi món ít ngọt, ưu tiên đề xuất trà hoặc cà phê có thể tùy chỉnh đường.", "entities": [{"name": "cà phê", "type": "menu_category", "normalized_name": "cà phê"}, {"name": "trà", "type": "menu_category", "normalized_name": "trà"}], "metadata": {"doc_type": "internal_policy", "version": "mock_v1"}}
