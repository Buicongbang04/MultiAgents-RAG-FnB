{"id": "doc_0056", "source_file": "mock_internal_policy.jsonl", "chunk_index": 55, "language": "vi", "text": "Khi khách hỏi món ăn nhẹ, ưu tiên đề xuất bánh hoặc snack trong menu.", "entities": [{"name": "menu", "type": "business_object", "normalized_name": "menu"}, {"name": "bánh", "type": "menu_category", "normalized_name": "bánh"}], "metadata": {"doc_type": "internal_policy", "version": "mock_v1"}}
{"id": "doc_0057", "source_file": "mock_internal_policy.jsonl", "chunk_index": 56, "language": "vi", "text": "Nếu khách nói không rõ hoặc chỉ chào hỏi, trợ lý nên phản hồi ngắn gọn và hỏi khách cần hỗ trợ gì.", "entities": [], "metadata": {"doc_type": "internal_policy", "version": "mock_v1"}}
