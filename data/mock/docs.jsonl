{"id": "doc_0051", "source_file": "mock_internal_policy.jsonl", "chunk_index": 50, "language": "vi", "text": "Với câu hỏi về wifi, giờ mở cửa, thanh toán hoặc hóa đơn, trợ lý phải ưu tiên dữ liệu FAQ.", "entities": [{"name": "wifi", "type": "policy", "normalized_name": "wifi"}, {"name": "giờ mở cửa", "type": "policy", "normalized_name": "giờ mở cửa"}, {"name": "thanh toán", "type": "policy", "normalized_name": "thanh toán"}, {"name": "hóa đơn", "type": "policy", "normalized_name": "hóa đơn"}], "metadata": {"doc_type": "internal_policy", "version": "mock_v1"}}
